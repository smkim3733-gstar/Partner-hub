# Vercel + Turso (Vercel Marketplace) + PRIVATE Vercel Blob.
# Copy to ignored .env.local for operator commands. Never commit actual values.
# Existing Sites production is separate and unchanged.
ANTHROPIC_EXTERNAL_PROCESSING_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Select native Vercel storage at build time. No Cloudflare account/Worker.
PARTNER_HUB_NEXT_BACKEND=vercel-storage-v1
# Set 1 ONLY after schema, administrator, data policy and preview checks.
PARTNER_HUB_BACKEND_ENABLED=0
# Exact HTTPS origin; no path or trailing slash. Separate preview/prod targets.
PARTNER_HUB_APP_ORIGIN=
# Injected by the Vercel Marketplace Turso integration (SQLite/libSQL compatible).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Injected after connecting a PRIVATE Blob store in Vercel Storage.
BLOB_READ_WRITE_TOKEN=
