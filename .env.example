# Vercel + Supabase migration target. Server secrets never use NEXT_PUBLIC_*.
# Copy to ignored .env.local for operator commands. Never commit actual values.
# Existing Sites production is separate and unchanged.
ANTHROPIC_EXTERNAL_PROCESSING_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Keep 0 until PostgreSQL schema, private bucket and preview checks pass.
PARTNER_HUB_NEXT_BACKEND=supabase-v1
# Set 1 ONLY after schema, administrator, data policy and preview checks.
PARTNER_HUB_BACKEND_ENABLED=0
# Exact HTTPS origin; no path or trailing slash. Separate preview/prod targets.
PARTNER_HUB_APP_ORIGIN=
# Server-only API endpoint and new-format secret key. Never send key in chat.
SUPABASE_URL=https://yievsveuxjnbygatvjtb.supabase.co
SUPABASE_SECRET_KEY=
# Vercel runtime: Supavisor transaction pooler, port 6543, sslmode=require.
SUPABASE_DATABASE_URL=
# Private bucket. Create through a reviewed migration/operator command.
# Direct-upload grants additionally require file_size_limit <= 26214400 and
# allowed_mime_types = ["application/octet-stream"]. Use 26214400 for full 25MiB support.
SUPABASE_STORAGE_BUCKET=partner-hub-private
