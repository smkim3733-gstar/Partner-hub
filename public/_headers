# Static HTML can bypass the application proxy at the edge. Keep its browser
# security boundary aligned with lib/browser-security-headers.ts.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

# Preserve long-lived caching for content-hashed application assets.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
