{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "dev:next": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:next:local": "node scripts/dev-next-local.mjs",
    "dev:next:local:http": "node scripts/dev-next-local.mjs --d1-http",
    "dev:next:local:files": "node scripts/dev-next-local.mjs --d1-http --r2-http --file-http",
    "admin:next:local": "node scripts/admin-next-local.mjs",
    "storage:check": "node --env-file-if-exists=.env.local scripts/vercel-storage.mjs check",
    "storage:init": "node --env-file-if-exists=.env.local scripts/vercel-storage.mjs init",
    "storage:cleanup:check": "node --env-file-if-exists=.env.local scripts/vercel-storage.mjs cleanup-check",
    "storage:cleanup": "node --env-file-if-exists=.env.local scripts/vercel-storage.mjs cleanup",
    "admin:vercel": "node --env-file-if-exists=.env.local scripts/admin-next-remote.mjs",
    "admin:vercel:check": "node --env-file-if-exists=.env.local scripts/admin-next-remote.mjs --check",
    "admin:vercel:recover": "node --env-file-if-exists=.env.local scripts/recover-next-remote-admin.mjs",
    "admin:next:remote": "node scripts/admin-next-remote.mjs",
    "admin:next:remote:check": "node scripts/admin-next-remote.mjs --check",
    "admin:next:remote:recover": "node scripts/recover-next-remote-admin.mjs",
    "admin:next:remote:recovery-check": "node scripts/recover-next-remote-admin.mjs --check",
    "deployment:prepare": "node scripts/prepare-standalone-deployment.mjs",
    "build:next": "next build",
    "start:next": "next start --hostname 127.0.0.1 --port 3001",
    "test:next": "node scripts/check-next-foundation.mjs",
    "test:next:vercel": "node scripts/check-next-remote-build.mjs --vercel",
    "test:next:local": "node --import ./scripts/register-local.mjs tests/next-local-storage-smoke.mjs",
    "test:next:local:r2": "node --import ./scripts/register-local.mjs tests/next-local-r2-smoke.mjs",
    "test:next:local:http": "node --import ./scripts/register-local.mjs tests/next-local-storage-smoke.mjs --d1-http",
    "test:next:local:files": "node --import ./scripts/register-local.mjs tests/next-local-storage-smoke.mjs --d1-http --r2-http --file-http",
    "test:next:remote": "node --import ./scripts/register-local.mjs tests/next-remote-https-smoke.mjs",
    "test:next:remote:build": "node scripts/check-next-remote-build.mjs",
    "test:deployment:package": "node --import ./scripts/register-local.mjs tests/standalone-package-smoke.mjs",
    "test:r2:http": "node --import ./scripts/register-local.mjs tests/r2-http-worker-smoke.mjs",
    "test:storage:http": "node tests/password-worker-smoke.mjs --d1-http --r2-http",
    "test:files:worker": "node --import ./scripts/register-local.mjs tests/file-transfer-worker-smoke.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "test:workerd": "node tests/password-worker-smoke.mjs",
    "test:d1:http": "node tests/password-worker-smoke.mjs --d1-http",
    "test:all": "pnpm test && pnpm run test:workerd",
    "dev:e2e": "vinext dev --host 127.0.0.1",
    "test:e2e": "playwright test",
    "bundle:verify": "node scripts/verify-client-bundle.mjs",
    "health:production": "node scripts/check-production-health.mjs",
    "release:verify": "node scripts/verify-release-manifest.mjs",
    "verify": "pnpm run release:verify && pnpm run typecheck && pnpm run lint && pnpm run test:all && pnpm run test:e2e && pnpm run build && pnpm run bundle:verify"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.0",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fflate": "0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
