# dependencies
/node_modules
# Local dependency copies are recreated with the lockfile, never transferred.
/*-node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Private runtime data and credentials never belong in the public source repository.
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.key
*.p12
*.pfx
*.phbackup
*.phbackup.partial
/data/
/uploads/
/private/
/backups/

# deployment and generated files
.vercel
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Deployment packaging must also exclude nested local Worker state under dist/server.
/outputs/
/work/

# Claude per-machine settings, sessions and isolated checkouts are not shared.
CLAUDE.local.md
/.claude/settings.local.json
/.claude/worktrees/
/.claude/sessions/
